# Base URL of the portfolio API.
#
# This is a build-time value, not a secret: Vite inlines every VITE_* variable
# into the client bundle. Set it in your hosting provider's environment settings
# (Vercel: Project Settings -> Environment Variables) rather than committing it.
#
# Local development against a locally running backend:
VITE_API_BASE_URL=http://localhost:8080
